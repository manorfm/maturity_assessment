{
  "name": "maturity-assessment",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "audit:instrument": "node --import tsx scripts/audit-instrument.ts",
    "demo:test-server": "node --import tsx test/e2e/demo-server.ts",
    "demo:serve": "SHOWCASE_GUIDE=/private/tmp/maturity-assessment-showcase-pilot-v1.html DATABASE_PATH=/private/tmp/maturity-assessment-e2e-pilot-v1.sqlite PORT=3217 node --import tsx src/server.ts",
    "demo": "npm run test:e2e && npm run demo:serve",
    "showcase": "npm run demo",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
